<?xml version="1.0"?>
<sdf version="1.9">
  <world name="survey">
    <physics name="1ms" type="ode"><max_step_size>0.01</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>0 0 100 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.4 0.2 -0.9</direction></light>
    <model name="ground"><static>true</static><link name="l"><visual name="v"><geometry><plane><normal>0 0 1</normal><size>2000 2000</size></plane></geometry><material><ambient>0.35 0.5 0.25 1</ambient><diffuse>0.35 0.5 0.25 1</diffuse></material></visual></link></model>
    <model name="car_red"><static>true</static><pose>10 5 0.75 0 0 0.5</pose><link name="l"><visual name="v"><geometry><box><size>4.5 2 1.5</size></box></geometry><material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual></link></model>
    <model name="car_blue"><static>true</static><pose>-30 -10 0.75 0 0 -0.3</pose><link name="l"><visual name="v"><geometry><box><size>4.5 2 1.5</size></box></geometry><material><ambient>0.1 0.2 0.9 1</ambient><diffuse>0.1 0.2 0.9 1</diffuse></material></visual></link></model>
    <model name="nadir_cam"><static>true</static><pose>0 0 80 0 1.5708 1.5708</pose><link name="l"><sensor name="cam" type="camera"><camera><horizontal_fov>1.5708</horizontal_fov><image><width>640</width><height>480</height></image><clip><near>0.1</near><far>500</far></clip></camera><always_on>1</always_on><update_rate>5</update_rate><topic>nadir/image</topic></sensor></link></model>
  </world>
</sdf>
